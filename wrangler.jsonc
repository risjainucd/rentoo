{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rentoo",
  "account_id": "b572ad0da703afe2e58898eef8444b59",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "rentoo.cloudflareaccess.com",
    "ACCESS_AUD": "9fa29aca0c658f01ab13ae7c87184acba5c8004c108159c15ef157cda516d04c"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rentoo-listings",
      "database_id": "6cfa4150-fe8a-4327-8e38-ff0a3cd4139d"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "cda5da94dd114027b0f8d92fb5767539" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rentoo-photos" }
  ]
}
