---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { getNeighbourhood, listListings, listNeighbourhoods } from '../../lib/db';
const n = await getNeighbourhood(Astro.locals.db, Astro.params.slug!);
if (!n) return Astro.redirect('/404', 404);
const { items } = await listListings(Astro.locals.db, { neighbourhood: n.slug });
const allNeighbourhoods = await listNeighbourhoods(Astro.locals.db);
const others = allNeighbourhoods.filter(nb => nb.slug !== n.slug);
---

<BaseLayout
  title={`Rent in ${n.name}, Jaipur — Hand-verified listings · Rentoo`}
  description={`${n.short_description ?? `Hand-verified rentals in ${n.name}, Jaipur.`} Browse flats and houses with WhatsApp-first inquiries.`}
>
  <SiteHeader slot="header" />

  <!-- Hero -->
  <section class="nbhd-hero">
    <div class="section-inner">
      <div class="byline">
        <span class="byline-label">Neighbourhood</span>
        <span class="byline-sep" aria-hidden="true">·</span>
        <span class="byline-meta">{n.name}</span>
      </div>
      <h1>{n.name}.</h1>
      {n.short_description && (
        <p class="lede">{n.short_description}</p>
      )}
    </div>
  </section>

  <!-- Stats strip -->
  <section class="nbhd-stats" aria-labelledby="stats-title">
    <div class="section-inner">
      <h2 id="stats-title" class="sr-only">At a glance</h2>
      <dl class="nbhd-stats-grid" role="list">
        <div class="nbhd-stat" role="listitem">
          <span class="stat-num">{items.length}</span>
          <span class="stat-label">Active listings</span>
        </div>
        <div class="nbhd-stat" role="listitem">
          <span class="stat-num">Jaipur</span>
          <span class="stat-label">City</span>
        </div>
        <div class="nbhd-stat" role="listitem">
          <span class="stat-num">Verified</span>
          <span class="stat-label">By Rentoo team</span>
        </div>
        <div class="nbhd-stat" role="listitem">
          <span class="stat-num">&lt;30 min</span>
          <span class="stat-label">WhatsApp reply</span>
        </div>
      </dl>
    </div>
  </section>

  <!-- Listings -->
  <section class="nbhd-listings">
    <div class="section-inner">
      <div class="section-head">
        <div class="section-head-num">02</div>
        <h2>Available in {n.name}</h2>
        <div class="section-head-meta">
          <a href={`/rent?neighbourhood=${n.slug}`}>All {n.name} listings →</a>
        </div>
      </div>

      {items.length === 0 ? (
        <div class="empty-state">
          <p>No listings available in {n.name} right now.</p>
          <a href="/rent" class="btn-secondary">Browse all rentals</a>
          <a href="https://wa.me/918740000854" class="btn-whatsapp">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
            </svg>
            Ask us on WhatsApp
          </a>
        </div>
      ) : (
        <div class="card-grid" role="list">
          {items.map(card => (
            <div role="listitem">
              <PropertyCard card={card} />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Other neighbourhoods -->
  {others.length > 0 && (
    <section class="nbhd-other">
      <div class="section-inner">
        <h3>Other neighbourhoods</h3>
        <div class="nbhd-chips">
          {others.map(nb => (
            <a href={`/neighbourhoods/${nb.slug}`}>
              {nb.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .section-inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Hero ── */
  .nbhd-hero {
    background: var(--paper);
    padding-block: var(--space-3xl) var(--space-2xl);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .nbhd-hero {
      padding-block: var(--space-4xl) var(--space-3xl);
    }
  }

  .nbhd-hero .section-inner {
    max-width: 820px;
  }

  .nbhd-hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.024em;
    max-width: 18ch;
    margin-top: var(--space-md);
  }

  .nbhd-hero .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-top: var(--space-xl);
    max-width: 60ch;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .byline-sep {
    color: var(--ink-soft);
  }

  /* ── Stats ── */
  .nbhd-stats {
    background: var(--paper);
    padding-bottom: var(--space-3xl);
  }

  .nbhd-stats .section-inner {
    max-width: var(--max-w);
  }

  .nbhd-stats-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(2, 1fr);
    padding: var(--space-xl);
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }

  @media (min-width: 768px) {
    .nbhd-stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-xl);
    }
  }

  .nbhd-stat .stat-num {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--jaipur-navy);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .nbhd-stat .stat-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: var(--space-xs);
  }

  /* ── Listings ── */
  .nbhd-listings {
    padding-block: var(--space-4xl);
  }

  .nbhd-listings .section-inner {
    max-width: var(--max-w);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .section-head-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--terracotta);
    text-transform: uppercase;
  }

  .section-head h2 {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head-meta {
    margin-left: auto;
    font-size: 0.9375rem;
  }

  .section-head-meta a {
    color: var(--jaipur-navy);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .section-head-meta a:hover {
    color: var(--terracotta);
  }

  .card-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Empty state ── */
  .empty-state {
    padding: var(--space-3xl) 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .empty-state p {
    font-size: 1rem;
    color: var(--ink-muted);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    background: transparent;
    color: var(--jaipur-navy);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--r-md);
    border: 1.5px solid var(--jaipur-navy);
    min-height: 44px;
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--jaipur-navy);
    color: var(--paper);
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    background: var(--whatsapp-signal);
    color: var(--paper);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--r-md);
    min-height: 44px;
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out);
  }

  .btn-whatsapp:hover {
    background: var(--whatsapp-deep);
  }

  /* ── SR only ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Other neighbourhoods ── */
  .nbhd-other {
    padding-block: var(--space-3xl) var(--space-4xl);
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .nbhd-other .section-inner {
    max-width: var(--max-w);
  }

  .nbhd-other h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-lg);
  }

  .nbhd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .nbhd-chips a {
    padding: 8px var(--space-md);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 999px;
    background: var(--paper-snow);
    border: 1px solid var(--line);
    color: var(--jaipur-navy);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .nbhd-chips a:hover {
    background: var(--jaipur-navy);
    color: var(--paper);
  }
</style>
