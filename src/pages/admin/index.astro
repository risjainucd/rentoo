---
export const prerender = false;
import { listAllForAdmin } from '../../lib/db';
const rows = await listAllForAdmin(Astro.locals.db);
const adminEmail = Astro.locals.adminEmail;
const rupees = (n: any) => `₹${Number(n).toLocaleString('en-IN')}`;
const title = (r: any) => [r.bhk_type, r.property_type].filter(Boolean).join(' ');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Rentoo Admin — Listings</title>
  <style>
    :root { --line:#e5e7eb; --ink:#0f172a; --muted:#64748b; --navy:#082746; --ok:#16a34a; --red:#dc2626; }
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; margin:0; color:var(--ink); background:#f8fafc; }
    header { background:var(--navy); color:#fff; padding:14px 20px; display:flex; justify-content:space-between; align-items:center; }
    header h1 { font-size:1rem; margin:0; letter-spacing:.02em; }
    header .who { font-size:.8rem; opacity:.8; }
    .wrap { padding:20px; max-width:1200px; margin:0 auto; }
    .count { color:var(--muted); font-size:.85rem; margin-bottom:12px; }
    table { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; font-size:.875rem; }
    th, td { text-align:left; padding:9px 12px; border-bottom:1px solid var(--line); white-space:nowrap; }
    th { background:#f1f5f9; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:#f8fafc; }
    .tag { font-size:.7rem; padding:2px 7px; border-radius:99px; font-weight:600; }
    .seg-residential { background:#eff6ff; color:#1d4ed8; }
    .seg-commercial { background:#f0fdf4; color:#15803d; }
    .seg-industrial { background:#fef3c7; color:#92400e; }
    .st-available { color:var(--ok); font-weight:600; }
    .st-rented { color:var(--red); font-weight:600; }
    .st-on-hold { color:#b45309; font-weight:600; }
    .muted { color:var(--muted); }
    .no { color:#cbd5e1; }
    .yes { color:var(--ok); font-weight:700; }
    a.edit { color:var(--navy); font-weight:600; text-decoration:none; }
    a.edit:hover { text-decoration:underline; }
    a.view { color:var(--muted); font-size:.8rem; text-decoration:none; }
  </style>
</head>
<body>
  <header>
    <h1>Rentoo Admin · Listings</h1>
    <span class="who">{adminEmail}</span>
  </header>
  <div class="wrap">
    <div class="count">{rows.length} listings</div>
    <table>
      <thead>
        <tr>
          <th>ID</th><th>Listing</th><th>Segment</th><th>Area</th><th>Rent</th>
          <th>Status</th><th>Pub</th><th>Feat</th><th>Media</th><th></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="muted">{r.display_id}</td>
            <td>{title(r) || r.property_type}</td>
            <td><span class={`tag seg-${r.segment}`}>{r.segment}</span></td>
            <td class="muted">{r.neighbourhood_slug}</td>
            <td>{rupees(r.rent_inr)}</td>
            <td><span class={`st-${r.status}`}>{r.status}</span></td>
            <td>{r.published ? <span class="yes">✓</span> : <span class="no">✕</span>}</td>
            <td>{r.featured ? <span class="yes">★</span> : <span class="no">—</span>}</td>
            <td class="muted">{r.photos}📷 {r.videos ? `${r.videos}🎬` : ''}</td>
            <td>
              <a class="edit" href={`/admin/${r.slug}`}>Edit</a>
              &nbsp;·&nbsp;
              <a class="view" href={`/${r.segment === 'commercial' ? 'commercial' : r.segment === 'industrial' ? 'industrial' : 'rent'}/${r.slug}`} target="_blank">view ↗</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</body>
</html>
