---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllForAdmin } from '../../lib/db';
const rows = await listAllForAdmin(Astro.locals.db);
const adminEmail = Astro.locals.adminEmail;
const rupees = (n: any) => `₹${Number(n).toLocaleString('en-IN')}`;
const title = (r: any) => [r.bhk_type, r.property_type].filter(Boolean).join(' ');
const viewPath = (r: any) => (r.segment === 'commercial' ? 'commercial' : r.segment === 'industrial' ? 'industrial' : 'rent');
const statusBadge = (s: string) => (s === 'available' ? 'badge--ok' : s === 'rented' ? 'badge--rest' : 'badge--warn');
---
<AdminLayout title="Rentoo Admin — Listings" email={adminEmail}>
  <div class="head">
    <div>
      <h1 class="page-title">Listings</h1>
      <p class="count">{rows.length} listings</p>
    </div>
    <a class="new-btn btn-sheen" href="/admin/new">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      New listing
    </a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>ID</th><th>Listing</th><th>Segment</th><th>Area</th><th>Rent</th><th>Status</th><th>Pub</th><th>Feat</th><th>Media</th><th></th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="muted mono">{r.display_id}</td>
            <td class="strong">{title(r) || r.property_type}</td>
            <td><span class={`badge seg-${r.segment}`}>{r.segment}</span></td>
            <td class="muted">{r.neighbourhood_slug}</td>
            <td class="num">{rupees(r.rent_inr)}</td>
            <td><span class={`badge st ${statusBadge(r.status)}`}>{r.status}</span></td>
            <td>{r.published ? <span class="badge badge--ok">Live</span> : <span class="badge badge--muted">Draft</span>}</td>
            <td>{r.featured ? <span class="badge badge--accent">★ Featured</span> : <span class="dash">—</span>}</td>
            <td>{r.photos > 0 ? <span class="muted mono">{r.photos}📷 {r.videos ? `${r.videos}🎬` : ''}</span> : <span class="needs">needs photos</span>}</td>
            <td class="actions">
              <a class="edit" href={`/admin/${r.slug}`}>Edit</a>
              <a class="view" href={`/${viewPath(r)}/${r.slug}`} target="_blank">view ↗</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <style>
    .head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-lg); margin-bottom: var(--space-lg); }
    .page-title { font-family: var(--font-display); font-size: 1.5rem; margin: 0 0 var(--space-xs); }
    .count { color: var(--ink-muted); font-size: .85rem; margin: 0; }
    .new-btn { display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; background: var(--color-primary); color: var(--color-primary-foreground); font-family: var(--font-display); font-weight: 600; font-size: .875rem; padding: 9px 16px; border-radius: var(--r-md); text-decoration: none; box-shadow: var(--elev-1); transition: background var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
    .new-btn:hover { background: var(--midnight-tile); transform: translateY(-1px); }
    /* Bounded height makes .table-wrap the scroll container the sticky <th> can pin within
       (a sticky header trapped by an unbounded overflow:auto ancestor never pins). */
    .table-wrap { background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--r-lg); box-shadow: var(--elev-1); overflow: auto; max-height: calc(100vh - 160px); }
    table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    th, td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--color-border); white-space: nowrap; vertical-align: middle; }
    th { position: sticky; top: 0; z-index: 1; font-family: var(--font-display); background: var(--color-surface-alt); font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted); }
    tr:last-child td { border-bottom: none; }
    tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--color-surface-alt) 45%, transparent); }
    tbody tr:hover td { background: var(--color-surface-alt); }
    .strong { font-weight: 600; }
    .muted { color: var(--ink-muted); }
    .mono { font-family: var(--font-mono); font-size: .8rem; }
    .num { font-variant-numeric: tabular-nums; }
    .dash { color: var(--ink-soft); }
    .st { text-transform: capitalize; }
    /* Segment badges layer brand colors on the global .badge base. */
    .seg-residential { background: var(--haze-tint); color: var(--jaipur-navy); border-color: color-mix(in srgb, var(--jaipur-navy) 18%, transparent); text-transform: capitalize; }
    .seg-commercial { background: var(--ok-mist); color: var(--ok-green); border-color: #C6E9D2; text-transform: capitalize; }
    .seg-industrial { background: var(--terracotta-mist); color: var(--terracotta); border-color: #E7CBBB; text-transform: capitalize; }
    .needs { color: var(--terracotta); font-weight: 600; font-size: .8rem; }
    .actions { display: flex; gap: var(--space-md); }
    .edit { color: var(--jaipur-navy); font-weight: 600; text-decoration: none; }
    .edit:hover { text-decoration: underline; }
    .view { color: var(--ink-muted); font-size: .8rem; text-decoration: none; }
    .view:hover { text-decoration: underline; }
  </style>
</AdminLayout>
