---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Still in the workshop — Rentoo"
  description="This part of Rentoo is still being curated. The homepage is live; the rest is coming soon."
>
  <SiteHeader slot="header" />

  <main>
    <div class="nf-wrap">
      <div class="nf-card">
        <div class="nf-tag">404 &middot; Not yet catalogued</div>
        <h1 class="nf-title">This section is still in the workshop.</h1>
        <p class="nf-body">
          The page you're looking for hasn't been built yet — or the link may have
          changed. If you were looking for a specific property or have a question,
          message us on WhatsApp and we'll send you what we have.
        </p>
        <div class="nf-actions">
          <a href="/" class="nf-btn nf-btn-primary">Back to the homepage</a>
          <a href="/rent" class="nf-btn nf-btn-ghost">Browse rentals</a>
          <a href="https://wa.me/918740000854" class="nf-btn nf-btn-ghost">WhatsApp us</a>
        </div>
        <div class="nf-meta">Rentoo &middot; Jaipur &middot; Hand-verified rentals</div>
      </div>
    </div>
  </main>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .nf-wrap {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 96px 24px;
  }

  .nf-card {
    max-width: 640px;
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 56px 48px;
    box-shadow: 0 1px 0 rgba(8, 39, 70, 0.03), 0 24px 48px -24px rgba(8, 39, 70, 0.08);
  }

  .nf-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 24px;
  }

  .nf-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--jaipur-navy);
    margin: 0 0 16px;
    font-weight: 600;
  }

  .nf-body {
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nf-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--r-md);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9375rem;
    min-height: 44px;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .nf-btn-primary {
    background: var(--jaipur-navy);
    color: var(--paper);
    border: 1.5px solid var(--jaipur-navy);
  }

  .nf-btn-primary:hover {
    background: #0a3258;
    border-color: #0a3258;
  }

  .nf-btn-ghost {
    background: transparent;
    color: var(--jaipur-navy);
    border: 1.5px solid var(--line);
  }

  .nf-btn-ghost:hover {
    background: var(--paper-warm);
    border-color: var(--jaipur-navy);
  }

  .nf-meta {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (max-width: 600px) {
    .nf-card {
      padding: 40px 28px;
    }
  }
</style>
