---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionMarker from '../components/SectionMarker.astro';
import PropertyCard from '../components/PropertyCard.astro';
import FeaturedHero from '../components/FeaturedHero.astro';
import { featuredListings, getFeaturedListing, listMajorAreas } from '../lib/db';
import { WHATSAPP_NUMBER } from '../lib/site';
// Three reads with no data dependency on one another, so awaiting them in sequence bought
// nothing and cost the page the SUM of their latencies before the first byte of HTML — five D1
// round trips, since the two listing calls each fetch their photos in a follow-up query. Issued
// together, the page waits on the slowest chain instead. Promise.all attaches a handler to every
// input as it is called, so a rejection on any of them still surfaces here exactly as the serial
// awaits did, with no unhandled rejection left behind.
const db = Astro.locals.db;
const [featured, featuredOne, areas] = await Promise.all([
  featuredListings(db, 6),
  getFeaturedListing(db),
  listMajorAreas(db),
]);
---

<BaseLayout title="Rentoo: Curated rentals in Jaipur" description="Hand-verified residential, commercial, and industrial rentals in Jaipur. Transparent brokerage, agreed up front. WhatsApp-first response within 30 minutes.">
  <SiteHeader slot="header" />

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-aura" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="byline">
          <span class="byline-label">Curated by</span>
          <span class="byline-name">Satvik + the Rentoo team</span>
          <span class="byline-sep" aria-hidden="true">·</span>
          <span class="byline-meta">Jaipur, since 2021</span>
        </p>

        <h1 id="hero-title">We visit every property.<br />Then we send you the ones that fit.</h1>

        <p class="hero-sub">A Jaipur brokerage firm. Every listing hand-verified. Most inquiries answered on WhatsApp within 30 minutes.</p>
        <p class="hero-scarcity">Our flats rent out fast — hope you're lucky to get one.</p>

        <form class="hero-search" role="search" action="/rent" method="get">
          <div class="search-grid">
            <label class="search-field">
              <span class="field-label">Locality</span>
              <select name="area">
                <option value="">Any area</option>
                {areas.map(a => <option value={a.slug}>{a.name}</option>)}
              </select>
            </label>
            <label class="search-field">
              <span class="field-label">BHK</span>
              <select name="bhk">
                <option value="">Any</option>
                <option value="1BHK">1 BHK</option>
                <option value="2BHK">2 BHK</option>
                <option value="3BHK">3 BHK</option>
                <option value="4BHK">4 BHK</option>
              </select>
            </label>
            <label class="search-field">
              <span class="field-label">Budget</span>
              <select name="maxRent">
                <option value="">Any</option>
                <option value="20000">Under ₹20K</option>
                <option value="30000">Under ₹30K</option>
                <option value="50000">Under ₹50K</option>
                <option value="100000">Under ₹1L</option>
              </select>
            </label>
          </div>
          <button type="submit" class="btn-primary search-submit btn-sheen">
            <span>Find homes</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <nav class="hero-chips" aria-label="Popular searches">
          <a href="/rent?bhk=2BHK&area=mansarovar">2BHK in Mansarovar</a>
          <a href="/commercial?area=c-scheme">Commercial in C-Scheme</a>
          <a href="/rent?bhk=3BHK&area=bapu-nagar">3BHK in Bapu Nagar</a>
          <a href="/rent?furnishing=furnished&maxRent=30000">Furnished under ₹30K</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- FEATURED PROPERTY (admin-flagged, else the most recently added available listing) -->
  {featuredOne && <FeaturedHero card={featuredOne} />}

  <!-- RECENTLY ADDED / FEATURED -->
  <section class="section section--recently-added" aria-labelledby="recently-added-title">
    <div class="section-inner">
      <SectionMarker num="01" label="Just added to the catalog" id="recently-added-title" meta="See all listings ↗" metaHref="/rent" />
      {featured.length === 0 ? (
        <p class="empty-state">No listings yet — check back soon.</p>
      ) : (
        <div class="card-grid" role="list">
          {featured.map((card, i) => (
            <div role="listitem" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <PropertyCard card={card} />
            </div>
          ))}
        </div>
      )}
      <div class="section-see-all">
        <a href="/rent" class="btn-secondary">See all listings &nbsp;↗</a>
      </div>
    </div>
  </section>

  <!-- BROWSE BY AREA -->
  {areas.length > 0 && (
    <section class="section section--areas" aria-labelledby="areas-title">
      <div class="section-inner">
        <SectionMarker num="02" label="By area" id="areas-title" meta="Pick what you know" />
        <nav class="area-chips" aria-label="Browse by area" data-reveal>
          {areas.map(a => (
            <a href={`/rent?area=${a.slug}`}>
              <span>{a.name}</span>
              {a.n ? <span class="area-count">{a.n}</span> : null}
            </a>
          ))}
        </nav>
      </div>
    </section>
  )}

  <!-- EDITORIAL: WHY RENTOO -->
  <section class="editorial-section" aria-labelledby="why-title">
    <div class="section-inner">
      <p class="editorial-kicker" data-reveal>A note from the team</p>
      <h2 id="why-title" data-reveal style="--reveal-delay:60ms">Most rental sites in Jaipur list whatever the broker sends them. We don't.</h2>

      <div class="editorial-body" data-reveal style="--reveal-delay:120ms">
        <p>Every property on Rentoo has been visited by someone on our team before it shows up here. We meet the owners, walk the place, take the photos ourselves. If something is broken or the rent is unrealistic, we say so or we don't list it.</p>

        <p>Our brokerage is <strong>standard and agreed up front</strong> — no hidden charges, no surprises at signing. You'll know exactly what the rent, the deposit, and our fee are before you ever see the flat.</p>

        <p>Our phone is the same as our WhatsApp. If you message us, you're messaging Satvik or someone on the team directly, not a call centre. Most inquiries get a reply within 30 minutes during business hours.</p>
      </div>

      <div class="editorial-proof" role="list" data-reveal style="--reveal-delay:180ms">
        <div class="proof-stat" role="listitem">
          <span class="stat-num">247</span>
          <span class="stat-label">Families placed since 2021</span>
        </div>
        <div class="proof-stat" role="listitem">
          <span class="stat-num">26 min</span>
          <span class="stat-label">Median WhatsApp response (last 30 days)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section--testimonials" aria-labelledby="testimonials-title">
    <div class="section-inner">
      <SectionMarker num="03" label="Word of mouth" id="testimonials-title" meta="Recent moves" />

      <div class="testimonial-row" role="list">
        <figure class="testimonial" role="listitem" data-reveal>
          <blockquote>
            <p>Found my Mansarovar apartment in 2 days. Satvik visited every place with me, no broker games. The photos online were the photos in person.</p>
          </blockquote>
          <figcaption>
            <span class="testimonial-avatar" aria-hidden="true">PS</span>
            <div>
              <strong>Priya S.</strong>
              <span>Software engineer · 2BHK in Mansarovar</span>
            </div>
          </figcaption>
        </figure>

        <figure class="testimonial" role="listitem" data-reveal style="--reveal-delay:90ms">
          <blockquote>
            <p>We had been searching for office space in C-Scheme for months. Rentoo's listings were the only ones with accurate area numbers and real photos. Signed in a week.</p>
          </blockquote>
          <figcaption>
            <span class="testimonial-avatar" aria-hidden="true">AM</span>
            <div>
              <strong>Ankit M.</strong>
              <span>Startup founder · 900 sqft office in C-Scheme</span>
            </div>
          </figcaption>
        </figure>

        <figure class="testimonial" role="listitem" data-reveal style="--reveal-delay:180ms">
          <blockquote>
            <p>First time renting in Jaipur from Delhi. Rentoo replied to my WhatsApp at 9pm with everything I needed. Moved in 10 days later. No site visits required from my end.</p>
          </blockquote>
          <figcaption>
            <span class="testimonial-avatar" aria-hidden="true">RK</span>
            <div>
              <strong>Rohit K.</strong>
              <span>Consultant · 3BHK in Vaishali Nagar</span>
            </div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- CURATOR SIGN-OFF -->
  <section class="curator-signoff" aria-labelledby="signoff-title">
    <div class="section-inner">
      <div class="signoff-portrait" aria-hidden="true" data-reveal>ST</div>
      <div class="signoff-body" data-reveal style="--reveal-delay:90ms">
        <p id="signoff-title">Hi, I'm Satvik. If you've made it this far, you probably have something specific in mind.</p>

        <p>Tell me what you're after on WhatsApp. Locality, BHK, budget, move-in date, anything that matters. I'll send you 3 to 5 places I'd actually live in myself, with notes on each one.</p>

        <p>If I don't have something right today, I'll keep an eye out and tell you when something fits.</p>

        <div class="signoff-actions">
          <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hi Rentoo — looking for a ___ in ___, budget ___.")}`} class="btn-whatsapp btn-whatsapp--lg btn-sheen">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
            </svg>
            Send WhatsApp to Satvik
          </a>
        </div>

        <p class="signoff-meta">+91 87400 00854 · connect@rentoo.in · Mangalam Radiance, Durgapura</p>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ── Section wrapper ── */
  .section-inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--paper);
    padding-block: var(--space-4xl) var(--space-3xl);
    /* A Jaipur dawn over navy: warm terracotta glow upper-right, a deep
       midnight pool lower-left, on a graded navy ground. */
    background:
      radial-gradient(115% 130% at 90% -25%, rgba(181, 83, 46, 0.32), transparent 46%),
      radial-gradient(90% 95% at 6% 112%, rgba(19, 58, 96, 0.65), transparent 55%),
      linear-gradient(162deg, #0c3157 0%, #082746 52%, #061d33 100%);
  }

  /* Fine dot-grid texture, masked so it fades toward the edges — craft detail
     you feel more than see. */
  .hero-aura {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at center, rgba(250, 247, 238, 0.06) 1px, transparent 1.5px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(125% 85% at 50% 0%, #000 32%, transparent 78%);
    mask-image: radial-gradient(125% 85% at 50% 0%, #000 32%, transparent 78%);
  }

  /* A warm glow that slowly drifts across the hero (motion only). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-aura::before {
      content: "";
      position: absolute;
      inset: -30%;
      background: radial-gradient(40% 40% at 50% 50%, rgba(181, 83, 46, 0.16), transparent 70%);
      animation: hero-drift 16s var(--ease-out) infinite alternate;
    }
  }

  @keyframes hero-drift {
    from { transform: translate(-8%, -5%); }
    to   { transform: translate(10%, 7%); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero-text {
    max-width: 56ch;
  }

  /* Staggered load-in (CSS only, so the hero never waits on JS). Reduced-motion
     users get the final state immediately. */
  @media (prefers-reduced-motion: no-preference) {
    /* `backwards` (not `both`): hold the start state during the delay, but don't
       forwards-fill — otherwise the finished animation would pin transform:none
       and defeat the search card's :focus-within lift. */
    .hero-text > * { animation: hero-rise 600ms var(--ease-out) backwards; }
    .hero-text > .byline { animation-delay: 60ms; }
    .hero-text > h1 { animation-delay: 140ms; }
    .hero-text > .hero-sub { animation-delay: 240ms; }
    .hero-text > .hero-search { animation-delay: 340ms; }
    .hero-text > .hero-chips { animation-delay: 440ms; }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(250, 247, 238, 0.6);
    margin-bottom: var(--space-lg);
  }

  .byline-name {
    color: rgba(250, 247, 238, 0.9);
  }

  .byline-sep {
    color: rgba(250, 247, 238, 0.3);
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-lg);
    color: var(--paper);
  }

  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(250, 247, 238, 0.75);
    margin-bottom: var(--space-md);
    max-width: 52ch;
  }

  /* Playful scarcity line under the sub-head. */
  .hero-scarcity {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.9375rem;
    font-weight: 600;
    font-style: italic;
    /* Terracotta is spent on the section-marker numbers (The One Voice Rule); on the navy
       hero it also measured 2.66:1, below AA. Paper at 90% reads clearly and stays quiet. */
    color: rgba(250, 247, 238, 0.9);
    margin-bottom: var(--space-2xl);
  }

  /* ── Hero search form ── */
  .hero-search {
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    box-shadow: 0 14px 36px rgba(8, 39, 70, 0.30), 0 2px 6px rgba(8, 39, 70, 0.18);
    transition: box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out);
  }

  .hero-search:focus-within {
    box-shadow: 0 22px 50px rgba(8, 39, 70, 0.38), 0 3px 8px rgba(8, 39, 70, 0.20);
    transform: translateY(-3px);
  }

  .search-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .search-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .search-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .search-field input,
  .search-field select {
    padding: var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--paper-snow);
    outline: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .search-field input:focus,
  .search-field select:focus {
    border-color: var(--jaipur-navy);
    box-shadow: 0 0 0 2px rgba(8, 39, 70, 0.12);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    background: var(--jaipur-navy);
    color: var(--paper);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--r-md);
    border: none;
    cursor: pointer;
    min-height: 48px;
    box-shadow: var(--elev-1);
    transition: background var(--dur-base) var(--ease-out),
                box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    text-decoration: none;
  }

  .btn-primary:hover {
    background: var(--midnight-tile);
    box-shadow: var(--elev-3);
    transform: translateY(-1px);
  }

  .search-submit {
    width: 100%;
  }

  .search-submit svg {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .search-submit:hover svg {
    transform: translateX(3px);
  }

  @media (min-width: 640px) {
    .search-submit {
      width: auto;
      align-self: flex-end;
    }
  }

  /* ── Hero chips ── */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero-chips a {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.8125rem;
    font-weight: 500;
    border: 1px solid rgba(250, 247, 238, 0.2);
    border-radius: var(--r-sm);
    color: rgba(250, 247, 238, 0.8);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .hero-chips a:hover {
    background: rgba(250, 247, 238, 0.1);
    color: var(--paper);
  }

  /* ── Recently Added section ── */
  .section {
    padding-block: var(--space-4xl);
  }

  .section--recently-added {
    background: var(--paper);
  }

  .card-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    padding: var(--space-3xl) 0;
    color: var(--ink-muted);
    font-size: 1rem;
  }

  .section-see-all {
    margin-top: var(--space-2xl);
    text-align: center;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    background: transparent;
    color: var(--jaipur-navy);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--r-md);
    border: 1px solid var(--jaipur-navy);
    min-height: 48px;
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--jaipur-navy);
    color: var(--paper);
  }

  /* ── Areas section ── */
  .section--areas {
    background: var(--paper-warm);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .area-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    margin-inline-start: var(--space-sm);
  }

  .area-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .area-chips a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-md) var(--space-xl);
    font-size: 0.9375rem;
    font-weight: 500;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--paper);
    color: var(--jaipur-navy);
    text-decoration: none;
    min-height: 44px;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .area-chips a:hover {
    background: var(--jaipur-navy);
    color: var(--paper);
  }

  /* ── Editorial section ── */
  .editorial-section {
    padding-block: var(--space-4xl);
    background: var(--jaipur-navy);
    color: var(--paper);
  }

  .editorial-section .section-inner {
    max-width: 800px;
  }

  .editorial-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(250, 247, 238, 0.5);
    margin-bottom: var(--space-md);
  }

  .editorial-section h2 {
    font-family: var(--font-display);
