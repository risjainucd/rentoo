---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SpaceDetail from '../../components/SpaceDetail.astro';
import { getListingBySlug } from '../../lib/db';
import { titleCase, withLocative, perSqftLabel } from '../../lib/utils';
const data = await getListingBySlug(Astro.locals.db, Astro.params.slug!);
if (!data) return Astro.redirect('/404', 404);
const { property, media, neighbourhood } = data;
const rupees = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const rateLabel = perSqftLabel(property.rent_inr, property.area_sqft);
const typeLabel = titleCase(property.property_type);
const landmarkNear = withLocative(property.landmark);
const pageTitle = [typeLabel, landmarkNear, `· ${property.display_id} — Rentoo`].filter(Boolean).join(' ');
---

<BaseLayout
  title={pageTitle}
  description={`${typeLabel}${landmarkNear ? ` ${landmarkNear}` : ''}, ${neighbourhood.name}. ${rupees(property.rent_inr)}/month${rateLabel ? ` (${rateLabel})` : ''}. Hand-verified by Rentoo.`}
>
  <SiteHeader slot="header" />
  <SpaceDetail property={property} media={media} neighbourhood={neighbourhood} />
  <SiteFooter slot="footer" />
</BaseLayout>
