---
import { mediaUrl } from '../lib/media';
import type { ListingCard } from '../lib/types';
import { WHATSAPP_NUMBER } from '../lib/site';
import Pill from './Pill.astro';

const { card } = Astro.props as { card: ListingCard };

// Same segment→section mapping the card uses, so the CTA lands on the right detail page.
const sectionPath = card.segment === 'commercial' ? '/commercial' : card.segment === 'industrial' ? '/industrial' : '/rent';
const href = `${sectionPath}/${card.slug}`;

// Larger `gallery` rendition than the card's `card` size — a real crispness upgrade for the big surface.
const key = (card.photos && card.photos.length ? card.photos[0] : card.cover_key) ?? null;
const img = key ? mediaUrl(key, 'gallery') : null;

// This photo is the page's LCP element, and `gallery` (1200px) is more than the slot ever asks
// for on a narrow screen. Offering `card` (600px) alongside it lets the browser drop to the
// smaller file wherever the slot genuinely fits it, and keep `gallery` where it doesn't. Only
// these two renditions are listed on purpose: `full` (2000px) would be picked by dense desktop
// displays and would make the LCP heavier than it is today.
const imgSrcset = key ? `${mediaUrl(key, 'card')} 600w, ${mediaUrl(key, 'gallery')} 1200w` : undefined;

// `sizes` has to describe the real rendered width of .featured-media or the choice above is a
// guess. Reading it off the style block below plus the layout tokens in globals.css:
//   .section-inner is border-box, so content width = min(100vw, 1280px) - 2 x --gutter,
//   and --gutter steps 16px -> 24px (>=768) -> 32px (>=1024);
//   below 900px the grid is one column, so the media takes that whole width;
//   from 900px up it is the 1.35fr track of a `1.35fr 1fr` grid split by a 48px (--space-3xl)
//   gap, i.e. (content - 48px) x 1.35/2.35;
//   past 1280px the container stops growing, so the media pins at a flat 671px.
const imgSizes = [
  '(min-width: 1280px) 671px',
  '(min-width: 1024px) calc((100vw - 112px) * 1.35 / 2.35)',
  '(min-width: 900px) calc((100vw - 96px) * 1.35 / 2.35)',
  '(min-width: 768px) calc(100vw - 48px)',
  'calc(100vw - 32px)',
].join(', ');

const statusVariant = card.status === 'available' ? 'status-available' : card.status === 'rented' ? 'status-rented' : 'status-on-hold';
const statusLabel = card.status === 'available' ? 'Available' : card.status === 'rented' ? 'Rented' : 'On Hold';

const waText = encodeURIComponent(`Hi Rentoo, I'm interested in ${card.display_id} (${card.slug}).`);
const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${waText}`;

const specs = [card.bhk_type, card.furnishing].filter(Boolean) as string[];
---

<section class="featured" aria-labelledby="featured-title" data-reveal>
  <div class="section-inner">
    <div class="featured-grid">
      <a class="featured-media" href={href} aria-label={`View ${card.title}`}>
        {img ? (
          <img
            src={img}
            srcset={imgSrcset}
            sizes={imgSizes}
            alt={card.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width={card.cover_w ?? 1200}
            height={card.cover_h ?? 800}
          />
        ) : (
          <div class="featured-media-placeholder"></div>
        )}
        <Pill variant="display-id" label={card.display_id} />
        <Pill variant={statusVariant} label={statusLabel} />
      </a>

      <div class="featured-body">
        <p class="featured-kicker">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/>
          </svg>
          Featured this week
        </p>
        <h2 id="featured-title" class="featured-title">{card.title}</h2>
        {card.landmark && <p class="featured-landmark">{card.landmark}</p>}
        <p class="featured-price">
          ₹{card.rent_inr.toLocaleString('en-IN')}<span class="featured-price-unit"> / month</span>
        </p>
        {specs.length > 0 && (
          <ul class="featured-specs" role="list">
            {specs.map((s) => <li>{s}</li>)}
          </ul>
        )}
        <div class="featured-ctas">
          <a class="featured-cta featured-cta--primary btn-sheen" href={href}>
            <span>View this home</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a class="featured-cta featured-cta--wa" href={waUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.13c-.24.68-1.2 1.26-1.97 1.42-.53.11-1.22.2-3.56-.77-2.99-1.24-4.92-4.27-5.07-4.47-.15-.2-1.22-1.62-1.22-3.09s.77-2.19 1.04-2.49c.27-.3.59-.37.79-.37.2 0 .39.002.56.01.18.008.42-.07.66.5.24.58.82 2.01.89 2.16.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.65-.07.18-.2.75-.87.95-1.17.2-.3.4-.25.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.35.07.12.07.72-.17 1.4z"/>
            </svg>
            <span>WhatsApp us</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .section-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .featured-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-3xl);
    }
  }

  /* — Media — */
  .featured-media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--haze-tint);
    border: 1px solid var(--line);
    box-shadow: var(--elev-2);
    transition: box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out);
  }

  .featured-media:hover {
    box-shadow: var(--elev-3);
    transform: translateY(-2px);
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-media:hover img { transform: scale(1.03); }
  }

  .featured-media-placeholder { width: 100%; height: 100%; background: var(--haze-tint); }

  /* The overlaid Pills are absolutely positioned inside Pill.astro; mute their clicks
     so the whole media stays a single link target. */
  .featured-media :global(.display-id-tag--card),
  .featured-media :global(.status-pill) { pointer-events: none; }

  /* — Body — */
  .featured-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-md);
  }
  .featured-kicker svg { fill: currentColor; }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--jaipur-navy);
    margin-bottom: var(--space-sm);
    text-transform: capitalize;
  }

  .featured-landmark {
    font-size: 1rem;
    color: var(--ink-muted);
    line-height: 1.4;
    margin-bottom: var(--space-lg);
  }

  .featured-price {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--jaipur-navy);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
  }
  .featured-price-unit {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .featured-specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0 0 var(--space-xl);
    padding: 0;
    list-style: none;
  }
  .featured-specs li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    color: var(--ink-muted);
    padding: 5px var(--space-md);
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  .featured-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 12px var(--space-xl);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-base) var(--ease-out),
                background var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
  }

  .featured-cta--primary {
    background: var(--jaipur-navy);
    color: var(--paper);
    box-shadow: var(--elev-1);
  }
  .featured-cta--primary:hover {
    background: var(--midnight-tile);
    box-shadow: var(--elev-2);
    transform: translateY(-1px);
  }
  .featured-cta--primary svg { transition: transform var(--dur-base) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) {
    .featured-cta--primary:hover svg { transform: translateX(3px); }
  }

  .featured-cta--wa {
    background: var(--paper-snow);
    color: var(--jaipur-navy);
    border: 1px solid var(--line);
  }
  .featured-cta--wa:hover {
    border-color: rgba(8, 39, 70, 0.2);
    box-shadow: var(--elev-1);
    transform: translateY(-1px);
  }
  .featured-cta--wa svg { color: var(--whatsapp-signal); }
</style>
