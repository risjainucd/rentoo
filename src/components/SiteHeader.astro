---
import { WHATSAPP_NUMBER } from '../lib/site';

const links = [
  { label: 'Residential', href: '/rent' },
  { label: 'Commercial', href: '/commercial' },
  { label: 'Industrial', href: '/industrial' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;

// The glyph appears twice (header CTA and drawer CTA). It used to be duplicated
// across two files because the drawer was a React island; one constant now.
const WHATSAPP_ICON_PATH = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413';
---

<header class="site-header" role="banner">
  <div class="nav-inner">
    <a href="/" class="logo">
      <img src="/Rentoo.svg" alt="Rentoo home" width="445" height="84" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {links.map(link => (
        <a
          href={link.href}
          aria-current={currentPath.startsWith(link.href) && link.href !== '/' ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href={`https://wa.me/${WHATSAPP_NUMBER}`} class="btn-whatsapp btn-sheen" data-cta="whatsapp-nav">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d={WHATSAPP_ICON_PATH} />
      </svg>
      <span>WhatsApp us</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-controls="mobile-nav"
    >
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line class="nav-toggle-bar nav-toggle-bar--top" x1="3" y1="6" x2="21" y2="6" />
        <line class="nav-toggle-bar nav-toggle-bar--mid" x1="3" y1="12" x2="21" y2="12" />
        <line class="nav-toggle-bar nav-toggle-bar--bottom" x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  {/* Opened with showModal(): the top layer, the focus trap, Escape handling and
      the ::backdrop all come from the platform, so this drawer needs no framework.
      Being in the top layer also means the header's backdrop-filter — which would
      otherwise become the containing block — cannot pull it out of the viewport. */}
  <dialog id="mobile-nav" class="mobile-sheet-content" aria-label="Site menu">
    <nav class="mobile-sheet-nav" aria-label="Mobile navigation">
      {links.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href={`https://wa.me/${WHATSAPP_NUMBER}`} class="btn-whatsapp btn-whatsapp--block">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d={WHATSAPP_ICON_PATH} />
        </svg>
        <span>WhatsApp us</span>
      </a>
    </nav>
  </dialog>
</header>

<script>
  // Condense the sticky header once the page scrolls past the top. The window
  // listener is bound once (module-level guard survives View Transitions); the
  // per-navigation astro:page-load re-applies state to the freshly swapped header.
  let bound = false;
  function applyHeaderScroll() {
    const header = document.querySelector('.site-header');
    if (header) header.toggleAttribute('data-scrolled', window.scrollY > 8);
  }
  function initHeaderScroll() {
    applyHeaderScroll();
    if (!bound) {
      bound = true;
      window.addEventListener('scroll', applyHeaderScroll, { passive: true });
    }
  }
  document.addEventListener('astro:page-load', initHeaderScroll);

  // ── Mobile drawer ──────────────────────────────────────────────────────────
  // A native <dialog> does the hard parts (focus trap, Escape, inert background,
  // backdrop); everything below is just open/close state and the exit animation,
  // which has to be driven from JS because close() hides the element instantly.
  const EXIT_MS = 200; // keep in step with --dur-base on .mobile-sheet-content

  let scrollLocked = false;

  // Hold the page still behind the drawer. The padding replaces the scrollbar the
  // lock removes so the sticky header never jumps sideways — a no-op on the phones
  // this drawer is for, whose scrollbars are overlays. body as well as html: iOS
  // Safari keeps scrolling when only the root element is locked.
  function lockScroll() {
    if (scrollLocked) return;
    scrollLocked = true;
    const root = document.documentElement;
    const gap = window.innerWidth - root.clientWidth;
    root.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    if (gap > 0) root.style.paddingRight = `${gap}px`;
  }

  function unlockScroll() {
    if (!scrollLocked) return;
    scrollLocked = false;
    const root = document.documentElement;
    root.style.overflow = '';
    root.style.paddingRight = '';
    document.body.style.overflow = '';
  }

  // The lock lives on <html>, which View Transitions never swap, so a navigation
  // that starts while the drawer is still animating shut would strand it locked.
  document.addEventListener('astro:before-swap', unlockScroll);

  function wireMobileNav(toggle: HTMLButtonElement, drawer: HTMLDialogElement) {
    let exitTimer = 0;
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setToggleState(isOpen: boolean) {
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    }

    function open() {
      window.clearTimeout(exitTimer);
      setToggleState(true);
      if (drawer.open) {
        // An exit was still in flight — the drawer never left, so calling off the
        // fade is the whole job. Skipping this would strand it open but invisible.
        drawer.removeAttribute('data-transition');
        return;
      }
      drawer.setAttribute('data-transition', 'enter');
      drawer.showModal();
      lockScroll();
      // Resolve style once while the drawer is still in its entry state: without
      // this the attribute removal lands in the same frame and nothing animates.
      void drawer.offsetWidth;
      drawer.removeAttribute('data-transition');
    }

    function close(restoreFocus: boolean) {
      if (!drawer.open) return;
      setToggleState(false);
      drawer.setAttribute('data-transition', 'exit');
      window.clearTimeout(exitTimer);
      const finish = () => {
        drawer.close();
        drawer.removeAttribute('data-transition');
        unlockScroll();
        // Escape and backdrop dismissals must land the user back on the hamburger.
        // Skipped for link clicks, where the page is already navigating away.
        if (restoreFocus && toggle.isConnected) toggle.focus();
      };
      if (reducedMotion()) finish();
      else exitTimer = window.setTimeout(finish, EXIT_MS);
    }

    toggle.addEventListener('click', () => (drawer.open ? close(true) : open()));

    // Escape fires `cancel` first and its default action closes the dialog outright,
    // skipping the exit animation — take it over instead.
    drawer.addEventListener('cancel', (event) => {
      event.preventDefault();
      close(true);
    });

    // A press on the ::backdrop reports the <dialog> itself as the target. Requiring
    // both ends of the click to land there stops a drag out of the drawer dismissing it.
    let pressedBackdrop = false;
    drawer.addEventListener('pointerdown', (event) => {
      pressedBackdrop = event.target === drawer;
    });
    drawer.addEventListener('click', (event) => {
      if (pressedBackdrop && event.target === drawer) close(true);
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => close(false));
    });
  }

  function initMobileNav() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const drawer = document.querySelector<HTMLDialogElement>('.mobile-sheet-content');
    if (!toggle || !drawer || toggle.dataset.navReady) return;
    // Browsers without <dialog> (pre-15.4 Safari) leave the toggle inert rather than
    // throwing; the CSS below keeps the drawer's markup hidden for them regardless.
    if (typeof drawer.showModal !== 'function') return;
    toggle.dataset.navReady = 'true';
    wireMobileNav(toggle, drawer);
  }

  document.addEventListener('astro:page-load', initMobileNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    transition: box-shadow var(--dur-base) var(--ease-out),
                background var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
  }

  @supports (backdrop-filter: blur(0)) {
    .site-header {
      background: rgba(250, 247, 238, 0.85);
    }
  }

  /* Condense on scroll — deepen the shadow and firm up the backdrop past the top.
     Shadow/background/border only (no size change), so it never shifts layout. */
  .site-header[data-scrolled] {
    box-shadow: 0 2px 14px rgba(8, 39, 70, 0.09);
    border-bottom-color: transparent;
  }

  @supports (backdrop-filter: blur(0)) {
    .site-header[data-scrolled] {
      background: rgba(250, 247, 238, 0.94);
    }
  }

  .nav-inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .logo {
    display: block;
    flex-shrink: 0;
  }

  .logo img {
    height: 20px;
    width: auto;
  }

  .primary-nav {
    display: none;
    align-items: center;
    gap: var(--space-xl);
    margin-left: var(--space-xl);
    flex: 1;
  }

  .primary-nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    padding: var(--space-sm) 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .primary-nav a:hover {
    color: var(--jaipur-navy);
  }

  /* Animated underline: grows from the left on hover, pinned for the active page. */
  .primary-nav a::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--jaipur-navy);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .primary-nav a:hover::after,
  .primary-nav a[aria-current="page"]::after,
  .primary-nav a.active::after {
    transform: scaleX(1);
  }

  /* The one WhatsApp identity: reserved green, navy label (8.64:1). WhatsApp's own
     colour is the strongest "tap me" signal this audience has — the header is where
     it has to read as WhatsApp, so it is no longer a calm navy. */
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--r-md);
    min-height: 48px;
    transition: background var(--dur-base) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    white-space: nowrap;
    background: var(--whatsapp-signal);
    color: var(--jaipur-navy);
  }

  .btn-whatsapp:hover {
    background: var(--whatsapp-deep);
  }

  /* Narrow phones tighten the button but keep the word: an unlabelled circle was the
     single conversion action on the page reading as decoration. */
  @media (max-width: 480px) {
    .btn-whatsapp {
      padding: var(--space-sm) var(--space-md);
      font-size: 0.9375rem;
      min-height: 44px;
    }
  }

  @media (min-width: 768px) {
    .primary-nav { display: flex; }
    .logo img { height: 24px; }
  }

  /* The hamburger replaces the primary nav below 768px, so it is the only way into
     the site's sections on a phone — hence the full 44px target. */
  :global(.nav-toggle) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border-radius: var(--r-md);
    color: var(--ink);
    transition: background var(--dur-fast) var(--ease-out);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  :global(.nav-toggle:hover) {
    background: var(--paper-warm);
  }

  @media (min-width: 768px) {
    :global(.nav-toggle) { display: none; }
  }

  /* Hamburger → X. These were inline styles keyed off React state; the button's own
     aria-expanded drives them now, so the morph needs nothing mirrored in script. */
  :global(.nav-toggle svg line) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--dur-fast) var(--ease-out),
                opacity var(--dur-fast) var(--ease-out);
  }

  :global(.nav-toggle[aria-expanded="true"] .nav-toggle-bar--top) {
    transform: translateY(6px) rotate(45deg);
  }

  :global(.nav-toggle[aria-expanded="true"] .nav-toggle-bar--mid) {
    opacity: 0;
  }

  :global(.nav-toggle[aria-expanded="true"] .nav-toggle-bar--bottom) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile drawer. Each declaration below reproduces a class the Base UI sheet
     carried (fixed inset-y-0 left-0 h-full w-3/4 sm:max-w-sm border-r shadow-lg,
     faded and slid 2.5rem in and out) so the drawer looks and moves as it did. */

  /* Stated rather than left to the UA: where <dialog> is unknown the element would
     otherwise be inline and its links would spill into the header. */
  :global(.mobile-sheet-content:not([open])) {
    display: none;
  }

  :global(.mobile-sheet-content) {
    position: fixed;
    inset-block: 0;
    left: 0;
    right: auto;
    width: 75%;
    height: 100%;
    /* The UA holds dialog:modal 2em clear of the viewport edges; a drawer wants none. */
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-right: 1px solid var(--line);
    background: var(--paper);
    background-clip: padding-box;
    color: var(--ink);
    font-size: 0.875rem;
    /* Base UI's SheetContent carried `shadow-lg`, a Tailwind black-based shadow.
       --elev-3 is the brand's top-surface elevation — the same swap the contact
       dialog got, so the two overlay surfaces are lit the same way. */
    box-shadow: var(--elev-3);
    /* Tailwind's ease-in-out, not the house --ease-out: this is the curve the sheet
       already moved on, and the motion is meant to be unchanged. */
    transition: opacity var(--dur-base) cubic-bezier(0.4, 0, 0.2, 1),
                transform var(--dur-base) cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.mobile-sheet-content[open]) {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 640px) {
    :global(.mobile-sheet-content) { max-width: 24rem; }
  }

  /* data-transition marks both ends of the animation: set before showModal() so the
     drawer enters from here, set again on close so it leaves the same way. */
  :global(.mobile-sheet-content[data-transition]) {
    opacity: 0;
    transform: translateX(-2.5rem);
  }

  /* Literal duration here, not --dur-fast: ::backdrop only started inheriting custom
     properties from its originating element recently, and an unresolved var() would
     void the whole declaration. */
  :global(.mobile-sheet-content::backdrop) {
    background: rgba(0, 0, 0, 0.1);
    transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @supports (backdrop-filter: blur(0)) {
    :global(.mobile-sheet-content::backdrop) {
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
  }

  :global(.mobile-sheet-content[data-transition]::backdrop) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.nav-toggle svg line),
    :global(.mobile-sheet-content),
    :global(.mobile-sheet-content::backdrop) {
      transition: none;
    }
  }

  :global(.mobile-sheet-nav) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--space-md) var(--gutter) var(--space-lg);
    border-top: 1px solid var(--line);
    background: var(--paper);
    height: 100%;
  }

  :global(.mobile-sheet-nav a) {
    padding: var(--space-md) 0;
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    display: block;
  }

  :global(.mobile-sheet-nav a:last-child) {
    border-bottom: none;
    margin-top: var(--space-md);
  }

  :global(.mobile-sheet-nav .btn-whatsapp) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--r-md);
    min-height: 48px;
    background: var(--whatsapp-signal);
    color: var(--jaipur-navy);
    width: 100%;
    justify-content: center;
  }

  :global(.mobile-sheet-nav .btn-whatsapp:hover) {
    background: var(--whatsapp-deep);
  }
</style>
