---
interface Props {
  variant: 'status-available' | 'status-rented' | 'status-on-hold' | 'verified' | 'display-id' | 'featured';
  label: string;
}

const { variant, label } = Astro.props;

const isStatus = variant.startsWith('status-');
const isVerified = variant === 'verified';
const isDisplayId = variant === 'display-id';
const isFeatured = variant === 'featured';
---

{isFeatured && (
  <span class="featured-pill">
    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/>
    </svg>
    {label}
  </span>
)}

{isDisplayId && (
  <span class="display-id-tag display-id-tag--card" aria-hidden="true">{label}</span>
)}

{isVerified && (
  <span class="verified-pill">
    <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
      <path d="M10.28 2.28L4.75 7.81 1.72 4.78a1 1 0 0 0-1.41 1.41l3.75 3.75a1 1 0 0 0 1.41 0l6.25-6.25a1 1 0 0 0-1.41-1.41z"/>
    </svg>
    {label}
  </span>
)}

{isStatus && variant === 'status-available' && (
  <span class="status-pill status-pill--available">
    <span class="dot" aria-hidden="true"></span>{label}
  </span>
)}

{isStatus && variant === 'status-rented' && (
  <span class="status-pill status-pill--rented">
    <span class="dot" aria-hidden="true"></span>{label}
  </span>
)}

{isStatus && variant === 'status-on-hold' && (
  <span class="status-pill status-pill--on-hold">
    <span class="dot" aria-hidden="true"></span>{label}
  </span>
)}

<style>
  /* Display ID tag */
  .display-id-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    padding: 2px var(--space-sm);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    min-width: 38px;
    height: 22px;
  }

  .display-id-tag--card {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 2;
    font-size: 0.6875rem;
    background: var(--paper-snow);
    color: var(--jaipur-navy);
    font-weight: 700;
    border: none;
    box-shadow: 0 1px 2px rgba(8, 39, 70, 0.12);
  }

  /* Status pill — a status is data, so it takes the mono label style.
     z-index keeps it above the card's hover scrim, which is painted at z-index 1
     precisely to make this pill legible and was covering it instead. */
  .status-pill {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 4px var(--space-sm);
    border-radius: var(--r-sm);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    bottom: var(--space-sm);
    top: auto;
    right: var(--space-sm);
    background: rgba(255, 255, 255, 0.94);
  }

  /* The documented badge-ok foreground: --ok-green on white is only 3.3:1. */
  .status-pill--available {
    color: #0F7A37;
  }

  /* Rented and on-hold are both deliberately inert, in Rest tones. On-hold used to
     borrow the focus-ring clay on a terracotta ground, which spent the one rationed
     accent on a non-event and read at 2.9:1. */
  .status-pill--rented,
  .status-pill--on-hold {
    background: rgba(241, 245, 249, 0.94);
    color: var(--ink-muted);
  }

  .status-pill .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* "Available now" heartbeat — only on available listings, motion only */
  @media (prefers-reduced-motion: no-preference) {
    .status-pill--available .dot {
      animation: dot-pulse 2.4s var(--ease-out) infinite;
    }
  }

  /* Derived from the dot's own colour so the halo can never drift from the pill. */
  @keyframes dot-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 50%, transparent); }
    70%  { box-shadow: 0 0 0 5px color-mix(in srgb, currentColor 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 0%, transparent); }
  }

  /* Verified pill */
  .verified-pill {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 4px var(--space-sm);
    border-radius: var(--r-sm);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    top: var(--space-sm);
    right: var(--space-sm);
    left: auto;
    background: rgba(220, 252, 231, 0.94);
    color: #0F7A37;
  }

  .verified-pill svg {
    fill: currentColor;
  }

  /* Featured — inline terracotta chip (used in the home marquee; reusable on cards). */
  .featured-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px var(--space-sm);
    border-radius: var(--r-sm);
    background: var(--terracotta-mist);
    color: var(--terracotta);
  }

  .featured-pill svg {
    fill: currentColor;
  }
</style>
