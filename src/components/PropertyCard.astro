---
import { mediaUrl } from '../lib/media';
import type { ListingCard } from '../lib/types';
import Pill from './Pill.astro';

const { card } = Astro.props as { card: ListingCard };

const href = `${card.segment === 'commercial' ? '/commercial' : '/rent'}/${card.slug}`;
const cover = card.cover_key ? mediaUrl(card.cover_key, 'card') : null;

const statusVariant = card.status === 'available'
  ? 'status-available'
  : card.status === 'rented'
  ? 'status-rented'
  : 'status-on-hold';

const statusLabel = card.status === 'available'
  ? 'Available'
  : card.status === 'rented'
  ? 'Rented'
  : 'On Hold';
---

<article class="property-card">
  <a href={href} class="card-link">
    <div class="card-image">
      <Pill variant="display-id" label={card.display_id} />
      {cover ? (
        <img
          src={cover}
          width={card.cover_w ?? 400}
          height={card.cover_h ?? 280}
          loading="lazy"
          alt={card.title}
        />
      ) : (
        <div class="card-image-placeholder"></div>
      )}
      <Pill variant={statusVariant} label={statusLabel} />
    </div>
    <div class="card-body">
      <div class="price-row">
        <span class="price">
          ₹{card.rent_inr.toLocaleString('en-IN')}<span class="price-unit"> / month</span>
        </span>
      </div>
      <h3 class="card-title">{card.title}</h3>
      {card.landmark && <p class="card-landmark">{card.landmark}</p>}
      <p class="card-meta-row">
        {card.bhk_type && <span>{card.bhk_type}</span>}
        {card.furnishing && card.bhk_type && <span aria-hidden="true"> · </span>}
        {card.furnishing && <span>{card.furnishing}</span>}
      </p>
    </div>
  </a>
</article>

<style>
  .property-card {
    background: var(--paper-snow);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--elev-1);
    transition: box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
    position: relative;
  }

  .property-card:hover {
    box-shadow: var(--elev-3), 0 0 0 1px rgba(8, 39, 70, 0.05);
    border-color: rgba(8, 39, 70, 0.18);
    transform: translateY(-3px);
  }

  .property-card:active {
    transform: translateY(-1px);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-image {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--haze-tint);
    overflow: hidden;
  }

  /* Bottom scrim — fades in on hover for status-pill legibility + depth */
  .card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 39, 70, 0.18), transparent 40%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
    z-index: 1;
  }

  .property-card:hover .card-image::after {
    opacity: 1;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* Override for images inside card-image */
  .card-image img {
    height: 100%;
  }

  .property-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--haze-tint);
  }

  .card-body {
    padding: var(--space-lg);
  }

  .price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .price {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--jaipur-navy);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .price-unit {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-landmark {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    line-height: 1.35;
    margin-bottom: var(--space-sm);
  }

  .card-meta-row {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line);
  }
</style>
