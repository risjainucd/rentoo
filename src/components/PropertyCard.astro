---
import { mediaUrl } from '../lib/media';
import type { ListingCard } from '../lib/types';
import Pill from './Pill.astro';

const { card } = Astro.props as { card: ListingCard };

const sectionPath = card.segment === 'commercial' ? '/commercial' : card.segment === 'industrial' ? '/industrial' : '/rent';
const href = `${sectionPath}/${card.slug}`;
const keys = card.photos && card.photos.length ? card.photos : card.cover_key ? [card.cover_key] : [];
const photoUrls = keys.map((k) => mediaUrl(k, 'card'));
const cover = photoUrls[0] ?? null;
const multi = photoUrls.length > 1;

const statusVariant = card.status === 'available'
  ? 'status-available'
  : card.status === 'rented'
  ? 'status-rented'
  : 'status-on-hold';

const statusLabel = card.status === 'available'
  ? 'Available'
  : card.status === 'rented'
  ? 'Rented'
  : 'On Hold';
---

<article class="property-card" data-card-photos={multi ? JSON.stringify(photoUrls) : undefined}>
  <div class="card-image">
    <Pill variant="display-id" label={card.display_id} />
    {card.featured === 1 && <Pill variant="featured" label="Featured" />}
    {cover ? (
      <img
        class="card-photo"
        data-card-img
        src={cover}
        width={card.cover_w ?? 400}
        height={card.cover_h ?? 280}
        loading="lazy"
        alt={card.title}
      />
    ) : (
      <div class="card-image-placeholder"></div>
    )}
    {multi && (
      <>
        <button type="button" class="card-nav card-nav--prev" data-card-prev aria-label="Previous photo">
          <span aria-hidden="true">&#8249;</span>
        </button>
        <button type="button" class="card-nav card-nav--next" data-card-next aria-label="Next photo">
          <span aria-hidden="true">&#8250;</span>
        </button>
        <div class="card-counter" aria-hidden="true"><span data-card-current>1</span> / {photoUrls.length}</div>
      </>
    )}
    <Pill variant={statusVariant} label={statusLabel} />
    {card.segment === 'residential' && (
      <button type="button" class="card-like" data-like-slug={card.slug} aria-pressed="false" aria-label="Save to favourites">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span class="card-like-count" data-like-count>{card.likes ? card.likes : ''}</span>
      </button>
    )}
  </div>
  <a href={href} class="card-link" aria-label={card.title}>
    <div class="card-body">
      <div class="price-row">
        <span class="price">
          ₹{card.rent_inr.toLocaleString('en-IN')}<span class="price-unit"> / month</span>
        </span>
      </div>
      <h3 class="card-title">{card.title}</h3>
      {card.landmark && <p class="card-landmark">{card.landmark}</p>}
      <p class="card-meta-row">
        {card.bhk_type && <span>{card.bhk_type}</span>}
        {card.furnishing && card.bhk_type && <span aria-hidden="true"> · </span>}
        {card.furnishing && <span>{card.furnishing}</span>}
      </p>
    </div>
  </a>
</article>

<script>
  import { swipeDirection } from '../lib/swipe';

  // Re-wired on every page load so the carousel survives View Transitions navs.
  function initCardCarousels() {
    document.querySelectorAll('[data-card-photos]').forEach((card) => {
      if ((card as HTMLElement).dataset.carouselReady) return;
      (card as HTMLElement).dataset.carouselReady = 'true';

      const img = card.querySelector('[data-card-img]') as HTMLImageElement | null;
      const cur = card.querySelector('[data-card-current]');
      const raw = card.getAttribute('data-card-photos');
      if (!img || !raw) return;
      let photos: string[];
      try { photos = JSON.parse(raw); } catch { return; }
      if (!Array.isArray(photos) || photos.length < 2) return;

      let i = 0;
      const show = (n: number) => {
        i = (n + photos.length) % photos.length; // wrap-around
        img.src = photos[i];
        if (cur) cur.textContent = String(i + 1);
      };
      // Arrows sit above the stretched card link; stop the click from navigating.
      const onClick = (fn: () => void) => (e: Event) => { e.preventDefault(); e.stopPropagation(); fn(); };
      card.querySelector('[data-card-prev]')?.addEventListener('click', onClick(() => show(i - 1)));
      card.querySelector('[data-card-next]')?.addEventListener('click', onClick(() => show(i + 1)));

      // ── Swipe ── the arrows are small targets on a phone.
      // Listen on the card, NOT on .card-image: a stretched <a class="card-link"> is painted
      // over the photo, so it — not the image — is the touch target, and .card-image is not on
      // that event's path. Which photo area the gesture started in is decided by hit-testing the
      // frame instead, so a drag over the text body still scrolls the page normally.
      const frame = card.querySelector('.card-image');
      if (!frame) return;
      let startX = 0, startY = 0, fromPhoto = false, swiped = false;
      card.addEventListener('touchstart', (e) => {
        const t = (e as TouchEvent).changedTouches[0];
        const r = frame.getBoundingClientRect();
        fromPhoto = t.clientX >= r.left && t.clientX <= r.right && t.clientY >= r.top && t.clientY <= r.bottom;
        startX = t.clientX; startY = t.clientY; swiped = false;
      }, { passive: true });
      card.addEventListener('touchend', (e) => {
        if (!fromPhoto) return;
        const t = (e as TouchEvent).changedTouches[0];
        const dir = swipeDirection(t.clientX - startX, t.clientY - startY);
        if (!dir) return; // a tap or a vertical scroll — leave it to the link and the page
        swiped = true;
        e.preventDefault(); // suppress the click this touch would otherwise synthesise
        show(dir === 'next' ? i + 1 : i - 1);
      }, { passive: false });
      // preventDefault on touchend does not reliably cancel the click everywhere, and here a
      // stray click opens the listing. Capture on the card so it runs before the link's own.
      card.addEventListener('click', (e) => {
        if (!swiped) return;
        swiped = false;
        e.preventDefault();
        e.stopPropagation();
      }, true);
    });
  }

  document.addEventListener('astro:page-load', initCardCarousels);

  // ── Favourites (❤️) ── device-local saved set + aggregate like counter.
  function initCardLikes() {
    let favs: string[] = [];
    try { favs = JSON.parse(localStorage.getItem('rentoo:favs') || '[]'); } catch { favs = []; }
    const save = () => localStorage.setItem('rentoo:favs', JSON.stringify(favs));

    document.querySelectorAll('[data-like-slug]').forEach((el) => {
      const btn = el as HTMLButtonElement;
      if (btn.dataset.likeReady) return;
      btn.dataset.likeReady = 'true';
      const slug = btn.getAttribute('data-like-slug') || '';
      const countEl = btn.querySelector('[data-like-count]') as HTMLElement | null;
      btn.setAttribute('aria-pressed', favs.includes(slug) ? 'true' : 'false');

      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const nowLiked = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', nowLiked ? 'true' : 'false');
        if (nowLiked) {
          // Restart the pop keyframe on each like (reflow forces re-trigger).
          btn.classList.remove('is-pop');
          void btn.offsetWidth;
          btn.classList.add('is-pop');
        }
        if (countEl) {
          const c = Math.max(0, (parseInt(countEl.textContent || '0', 10) || 0) + (nowLiked ? 1 : -1));
          countEl.textContent = c ? String(c) : '';
        }
        favs = nowLiked ? [...new Set([...favs, slug])] : favs.filter((s) => s !== slug);
        save();
        try {
          const res = await fetch(`/api/like/${slug}`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: nowLiked ? 'like' : 'unlike' }),
          });
          if (res.ok && countEl) {
            const d = await res.json() as { likes?: number };
            if (typeof d.likes === 'number') countEl.textContent = d.likes ? String(d.likes) : '';
          }
        } catch { /* offline — local state already updated */ }
      });
    });
  }

  document.addEventListener('astro:page-load', initCardLikes);
</script>

<style>
  .property-card {
    background: var(--paper-snow);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--elev-1);
    transition: box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
    position: relative;
  }

  .property-card:hover {
    box-shadow: var(--elev-3), 0 0 0 1px rgba(8, 39, 70, 0.05);
    border-color: rgba(8, 39, 70, 0.18);
    transform: translateY(-3px);
  }

  .property-card:active {
    transform: translateY(-1px);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole card navigates to the detail page, while the
     carousel arrows (higher z-index) stay clickable above this overlay. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--r-md);
  }

  .card-image {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--haze-tint);
    overflow: hidden;
  }

  /* Bottom scrim — fades in on hover for status-pill legibility + depth */
  .card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 39, 70, 0.18), transparent 40%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
    z-index: 1;
  }

  .property-card:hover .card-image::after {
    opacity: 1;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
    display: block;
    max-width: 100%;
  }

  .property-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--haze-tint);
  }

  /* Decorative overlays pass clicks through to the card link. */
  .card-image :global(.display-id-tag--card),
  .card-image :global(.status-pill),
  .card-image :global(.featured-pill) {
    pointer-events: none;
  }

  /* Featured ribbon: sits just under the display-id tag, top-left. */
  .card-image :global(.featured-pill) {
    position: absolute;
    top: calc(var(--space-sm) + 28px);
    left: var(--space-sm);
    z-index: 2;
    box-shadow: 0 1px 2px rgba(8, 39, 70, 0.12);
  }

  /* ── Carousel arrows ── */
  .card-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper, #fff) 84%, transparent);
    color: var(--jaipur-navy, #082746);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(8, 39, 70, 0.18);
    opacity: 0;
    transition: opacity var(--dur-fast, 150ms) var(--ease-out, ease-out),
                background var(--dur-fast, 150ms) var(--ease-out, ease-out),
                transform var(--dur-fast, 150ms) var(--ease-out, ease-out);
    outline: none;
  }

  .card-nav span {
    font-size: 1.25rem;
    line-height: 1;
    margin-top: -2px;
  }

  .card-nav--prev { left: 8px; }
  .card-nav--prev span { margin-right: 2px; }
  .card-nav--next { right: 8px; }
  .card-nav--next span { margin-left: 2px; }

  .property-card:hover .card-nav,
  .property-card:focus-within .card-nav {
    opacity: 1;
  }

  .card-nav:hover {
    background: var(--paper, #fff);
    transform: translateY(-50%) scale(1.08);
  }

  .card-nav:focus-visible {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--paper, #fff), 0 0 0 4px var(--jaipur-navy, #082746);
  }

  /* ── Photo counter (bottom-left; status pill is bottom-right) ── */
  .card-counter {
    position: absolute;
    bottom: var(--space-sm, 8px);
    left: var(--space-sm, 8px);
    z-index: 2;
    padding: 2px 8px;
    border-radius: var(--r-sm, 4px);
    background: color-mix(in srgb, var(--jaipur-navy, #082746) 76%, transparent);
    color: var(--paper, #fff);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast, 150ms) var(--ease-out, ease-out);
  }

  .property-card:hover .card-counter,
  .property-card:focus-within .card-counter {
    opacity: 1;
  }

  /* Touch devices have no hover: keep the controls visible. */
  @media (hover: none) {
    .card-nav,
    .card-counter { opacity: 1; }
  }

  /* ── Favourite (❤️) button ── top-right, above the stretched card link ── */
  .card-like {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    min-height: 32px;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper, #fff) 86%, transparent);
    color: var(--ink-muted, #64748b);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(8, 39, 70, 0.18);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: transform var(--dur-fast, 150ms) var(--ease-out, ease-out),
                color var(--dur-fast, 150ms) var(--ease-out, ease-out);
  }

  .card-like svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: fill var(--dur-fast, 150ms) var(--ease-out, ease-out);
  }

  .card-like:hover { transform: scale(1.08); }

  .card-like[aria-pressed="true"] { color: var(--danger-red, #dc2626); }
  .card-like[aria-pressed="true"] svg { fill: var(--danger-red, #dc2626); stroke: var(--danger-red, #dc2626); }

  /* Heart "pop" on like — a single spring-eased bump, only when actually liked. */
  @media (prefers-reduced-motion: no-preference) {
    .card-like.is-pop svg { animation: heart-pop 240ms var(--ease-spring); }
  }
  @keyframes heart-pop {
    0%   { transform: scale(1); }
    45%  { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .card-like-count {
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .card-like-count:empty { display: none; }

  .card-like:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--paper, #fff), 0 0 0 4px var(--jaipur-navy, #082746);
  }

  .card-body {
    padding: var(--space-lg);
  }

  .price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .price {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--jaipur-navy);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .price-unit {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-landmark {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    line-height: 1.35;
    margin-bottom: var(--space-sm);
  }

  .card-meta-row {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line);
  }
</style>
