---
// Shared detail body for commercial + industrial listings. The only
// segment-specific difference is the breadcrumb label/link, derived below.
import Gallery from './Gallery.astro';
import { mediaUrl, videoUrl } from '../lib/media';
import { WHATSAPP_NUMBER } from '../lib/site';
import type { Property, PropertyMedia, Neighbourhood } from '../lib/types';

interface Props { property: Property; media: PropertyMedia[]; neighbourhood: Neighbourhood; }
const { property, media, neighbourhood } = Astro.props as Props;

const isIndustrial = property.segment === 'industrial';
const sectionLabel = isIndustrial ? 'Industrial' : 'Commercial';
const sectionHref = isIndustrial ? '/industrial' : '/commercial';

const images = media.filter(m => m.kind === 'photo').map(m => ({
  gallery: mediaUrl(m.r2_key, 'gallery'),
  full: mediaUrl(m.r2_key, 'full'),
  alt: `${property.display_id} — ${property.property_type}`,
}));
const tourVideo = (() => {
  const v = media.find(m => m.kind === 'video');
  if (!v) return undefined;
  return {
    src: videoUrl(v.r2_key),
    poster: mediaUrl(v.r2_key, 'gallery'),
    alt: `${property.display_id} video tour`,
  };
})();
const waText = encodeURIComponent(`Hi Rentoo, I'm interested in ${property.display_id} (${property.slug}).`);
const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${waText}`;
const rupees = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const statusLabel = property.status === 'available' ? 'Available now' : property.status === 'rented' ? 'Rented out' : 'On hold';
const statusClass = property.status === 'available' ? 'status--available' : property.status === 'rented' ? 'status--rented' : 'status--on-hold';
const pricePerSqft = property.area_sqft ? Math.round(property.rent_inr / property.area_sqft) : null;
---

<!-- Breadcrumb -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="section-inner">
    <a href="/">Home</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <a href={sectionHref}>{sectionLabel}</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <a href={`${sectionHref}?neighbourhood=${neighbourhood.slug}`}>{neighbourhood.name}</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <span class="current" aria-current="page">
      {property.property_type} · {property.display_id}
    </span>
  </div>
</nav>

<!-- Gallery -->
{(images.length > 0 || tourVideo) ? (
  <div class="gallery-section">
    <div class="section-inner">
      <Gallery images={images} video={tourVideo} />
    </div>
  </div>
) : (
  <div class="gallery-placeholder" aria-hidden="true">
    <div class="section-inner"><div class="no-photos">Photos coming soon</div></div>
  </div>
)}

<!-- Detail layout -->
<section class="detail-layout">
  <div class="section-inner">

    <!-- Main content -->
    <div class="detail-main">

      <!-- Status row -->
      <div class="detail-status-row">
        <span class="display-id-tag">{property.display_id}</span>
        <span class="verified-inline">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19l12-12-1.41-1.41z"/></svg>
          Verified by Rentoo
        </span>
        <span class={`status-badge ${statusClass}`}>
          <span class="dot" aria-hidden="true"></span>
          {statusLabel}
        </span>
      </div>

      <h1>
        {property.property_type}
        {`, ${neighbourhood.name}`}
      </h1>

      {property.landmark && (
        <p class="detail-landmark">
          {property.landmark}
          {property.furnishing && ` · ${property.furnishing.charAt(0).toUpperCase() + property.furnishing.slice(1)}`}
        </p>
      )}

      <!-- Price block -->
      <div class="price-block">
        <span class="price-num">{rupees(property.rent_inr)}</span>
        <span class="price-suf">/ month</span>
        {pricePerSqft && (
          <span class="price-persqft">₹{pricePerSqft} / sq ft</span>
        )}
        <span class="price-note">Verified listing</span>
      </div>

      <!-- Key facts (area + sqft) -->
      {property.area_sqft && (
        <div class="key-facts" data-reveal>
          <div class="fact">
            <div class="fact-num">{property.area_sqft.toLocaleString('en-IN')}</div>
            <div class="fact-lbl">sq ft</div>
          </div>
          {pricePerSqft && (
            <div class="fact">
              <div class="fact-num">₹{pricePerSqft}</div>
              <div class="fact-lbl">per sq ft</div>
            </div>
          )}
        </div>
      )}

      <!-- Spec list -->
      <div class="detail-section" data-reveal>
        <h2>Property details</h2>
        <div class="spec-list">
          <div class="spec-row">
            <span class="spec-k">Property type</span>
            <span class="spec-v">{property.property_type}</span>
          </div>
          {property.furnishing && (
            <div class="spec-row">
              <span class="spec-k">Fit-out</span>
              <span class="spec-v">{property.furnishing.charAt(0).toUpperCase() + property.furnishing.slice(1)}</span>
            </div>
          )}
          {property.area_sqft && (
            <div class="spec-row">
              <span class="spec-k">Area</span>
              <span class="spec-v">{property.area_sqft.toLocaleString('en-IN')} sq ft</span>
            </div>
          )}
          {pricePerSqft && (
            <div class="spec-row">
              <span class="spec-k">Rate</span>
              <span class="spec-v">₹{pricePerSqft} / sq ft</span>
            </div>
          )}
          <div class="spec-row">
            <span class="spec-k">Status</span>
            <span class={`spec-v ${property.status === 'available' ? 'spec-v--ok' : property.status === 'rented' ? 'spec-v--rented' : ''}`}>{statusLabel}</span>
          </div>
          {property.landmark && (
            <div class="spec-row">
              <span class="spec-k">Nearby landmark</span>
              <span class="spec-v">{property.landmark}</span>
            </div>
          )}
          <div class="spec-row">
            <span class="spec-k">Neighbourhood</span>
            <span class="spec-v">{neighbourhood.name}</span>
          </div>
        </div>
      </div>

      <!-- Description -->
      {property.description && (
        <div class="detail-section" data-reveal>
          <h2>About this space</h2>
          <p>{property.description}</p>
        </div>
      )}

      <!-- Location -->
      <div class="detail-section" data-reveal>
        <h2>Location</h2>
        {property.map_url ? (
          <div class="map-embed-wrapper">
            <iframe
              src={property.map_url}
              width="100%"
              height="280"
              style="border:0;border-radius:var(--r-md)"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Map showing ${neighbourhood.name}`}
            ></iframe>
          </div>
        ) : (
          <div class="map-placeholder">
            <div class="map-pin">{neighbourhood.name}</div>
          </div>
        )}
        <div class="map-meta">
          <span>{neighbourhood.name}, Jaipur</span>
          {property.landmark && <span>{property.landmark}</span>}
        </div>
      </div>

    </div>

    <!-- Sticky sidebar CTA -->
    <aside class="sticky-cta" aria-label="Contact Rentoo">
      <div class="cta-card-inner">
        <div class="cta-card-kicker">Interested?</div>
        <div class="cta-card-title">
          Talk to Rentoo about <strong>{property.display_id}</strong>. We usually reply in under 30 minutes during business hours.
        </div>
        <div class="cta-card-actions">
          <a href={waUrl} class="btn-whatsapp btn-whatsapp--lg btn-sheen" data-cta="whatsapp-detail">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
            </svg>
            <span>Chat on WhatsApp</span>
          </a>
          <a href={`tel:+${WHATSAPP_NUMBER}`} class="btn-secondary">Request a callback</a>
        </div>
        <div class="cta-fineprint">Listed by Rentoo · Visit on request</div>
      </div>

      <!-- Location card -->
      <div class="location-card">
        <div class="location-card-lbl">Neighbourhood</div>
        <div class="location-card-name">{neighbourhood.name}</div>
        {property.landmark && (
          <div class="location-card-addr">near {property.landmark}</div>
        )}
        {neighbourhood.short_description && (
          <div class="location-card-desc">{neighbourhood.short_description}</div>
        )}
      </div>
    </aside>

  </div>
</section>

<!-- Mobile sticky CTA -->
<div class="mobile-sticky-cta" role="region" aria-label="Quick contact">
  <a href={waUrl} class="btn-whatsapp" data-cta="whatsapp-mobile-sticky">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
    </svg>
    <span>WhatsApp</span>
  </a>
  <a href={`tel:+${WHATSAPP_NUMBER}`} class="btn-secondary">Call</a>
</div>

<div id="view-beacon" data-slug={property.slug} hidden></div>
<script>
  // Count one view per session per listing.
  function beaconView() {
    const el = document.getElementById('view-beacon');
    const slug = el?.getAttribute('data-slug');
    if (!slug) return;
    const key = 'rentoo:viewed:' + slug;
    try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, '1'); } catch { /* ignore */ }
    fetch('/api/view/' + slug, { method: 'POST', keepalive: true }).catch(() => {});
  }
  document.addEventListener('astro:page-load', beaconView);
</script>

<style>
  .section-inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    padding: var(--space-md) 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .breadcrumb .section-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .breadcrumb a {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .breadcrumb a:hover {
    color: var(--jaipur-navy);
  }

  .breadcrumb-sep {
    color: var(--ink-soft);
  }

  .breadcrumb .current {
    color: var(--ink);
    font-weight: 600;
  }

  /* ── Gallery section ── */
  .gallery-section {
    padding-block: var(--space-xl) var(--space-md);
    background: var(--paper);
  }

  .gallery-placeholder {
    padding-block: var(--space-xl);
    background: var(--paper);
  }

  .no-photos {
    height: 200px;
    background: var(--haze-tint);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  /* ── Detail layout ── */
  .detail-layout {
    padding-block: var(--space-2xl) var(--space-4xl);
    background: var(--paper);
  }

  .detail-layout .section-inner {
    display: grid;
    gap: var(--space-3xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .detail-layout .section-inner {
      grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
      align-items: start;
    }
  }

  /* ── Status row ── */
  .detail-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    align-items: center;
  }

  .display-id-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    background: var(--paper-warm);
    border: 1px solid var(--line);
    padding: 4px var(--space-md);
    border-radius: var(--r-sm);
  }

  .verified-inline {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ok-green);
    background: var(--ok-mist);
    padding: 4px var(--space-sm);
    border-radius: var(--r-sm);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px var(--space-sm);
    border-radius: var(--r-sm);
  }

  .status-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .status--available {
    color: var(--ok-green);
    border: 1px solid var(--ok-green);
  }

  .status--rented {
    color: var(--danger-red);
    border: 1px solid var(--danger-red);
  }

  .status--on-hold {
    color: var(--terracotta);
    border: 1px solid var(--terracotta);
  }

  /* ── Detail main ── */
  .detail-main h1 {
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-sm);
    text-transform: capitalize;
  }

  .detail-landmark {
    font-size: 1rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-lg);
  }

  /* ── Price block ── */
  .price-block {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .price-num {
    font-size: 2rem;
    font-weight: 700;
    color: var(--jaipur-navy);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .price-suf {
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .price-persqft {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    padding-left: var(--space-sm);
    border-left: 1px solid var(--line);
  }

  .price-note {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  /* ── Key facts ── */
  .key-facts {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .key-facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .fact {
    padding: var(--space-md);
    background: var(--paper-snow);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-align: center;
    transition: box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
  }

  .fact:hover {
    box-shadow: var(--elev-2);
    transform: translateY(-2px);
    border-color: rgba(8, 39, 70, 0.18);
  }

  .fact-num {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--jaipur-navy);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .fact-lbl {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 4px;
  }

  /* ── Detail sections ── */
  .detail-section {
    margin-bottom: var(--space-3xl);
  }

  .detail-section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    letter-spacing: -0.005em;
  }

  .detail-section p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  /* ── Spec list ── */
  .spec-list {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--paper-snow);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .spec-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 11px var(--space-lg);
    border-bottom: 1px solid var(--line);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 640px) {
    .spec-row:nth-child(odd) {
      border-right: 1px solid var(--line);
    }
  }

  .spec-k {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .spec-v {
    font-size: 0.875rem;
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }

  .spec-v--ok {
    color: var(--ok-green);
    font-weight: 600;
  }

  .spec-v--rented {
    color: var(--danger-red);
    font-weight: 600;
  }

  /* ── Map ── */
  .map-embed-wrapper {
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .map-placeholder {
    height: 280px;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, #dde6f0, #c5d3e3);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-pin {
    background: var(--terracotta);
    color: var(--paper);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--r-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(181, 83, 46, 0.3);
    position: relative;
  }

  .map-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  /* ── Sticky sidebar CTA ── */
  .sticky-cta {
    position: sticky;
    top: calc(var(--header-h) + var(--space-lg));
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cta-card-inner {
    background: var(--paper-snow);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--space-xl);
    box-shadow: var(--elev-2);
  }

  .cta-card-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
