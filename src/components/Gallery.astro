---
interface Props { images: { gallery: string; full: string; alt: string }[] }
const { images } = Astro.props;
const cover = images[0];
const single = images.length <= 1;
---
<div class="gallery" data-gallery tabindex="0" role="group" aria-roledescription="carousel" aria-label="Photo gallery">
  <div class="gallery-stage">
    <img class="gallery-main" data-gallery-main src={cover?.gallery} alt={cover?.alt} width="1000" height="667" />
    {!single && (
      <>
        <button type="button" class="gallery-nav gallery-nav--prev" data-gallery-prev aria-label="Previous photo">
          <span aria-hidden="true">&#8249;</span>
        </button>
        <button type="button" class="gallery-nav gallery-nav--next" data-gallery-next aria-label="Next photo">
          <span aria-hidden="true">&#8250;</span>
        </button>
        <div class="gallery-counter" data-gallery-counter aria-hidden="true">
          <span data-gallery-current>1</span> / {images.length}
        </div>
      </>
    )}
  </div>
  <div class="gallery-thumbs">
    {images.map((img, i) => (
      <button class="gallery-thumb" data-gallery-thumb data-index={i} data-full={img.gallery} aria-label={`Photo ${i + 1}`} aria-current={i === 0}>
        <img src={img.gallery} alt={img.alt} width="120" height="80" loading="lazy" />
      </button>
    ))}
  </div>
</div>
<script>
  // Wired on every page load, including View Transitions navigations
  // (raw <script> tags don't re-execute on client-side nav).
  function initGalleries() {
    document.querySelectorAll('[data-gallery]').forEach((g) => {
      if ((g as HTMLElement).dataset.galleryReady) return;
      (g as HTMLElement).dataset.galleryReady = 'true';

      const main = g.querySelector('[data-gallery-main]') as HTMLImageElement | null;
      const thumbs = Array.from(g.querySelectorAll('[data-gallery-thumb]')) as HTMLButtonElement[];
      const prevBtn = g.querySelector('[data-gallery-prev]');
      const nextBtn = g.querySelector('[data-gallery-next]');
      const current = g.querySelector('[data-gallery-current]');
      const total = thumbs.length;
      if (!main || total === 0) return;

      let index = 0;

      const show = (next: number) => {
        index = (next + total) % total; // wrap-around
        const full = thumbs[index].getAttribute('data-full');
        if (full && main.getAttribute('src') !== full) {
          // Preload, then crossfade to the new photo.
          const img = new Image();
          img.onload = () => { main.src = full; main.style.opacity = '1'; };
          main.style.opacity = '0';
          img.src = full;
        }
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
        if (current) current.textContent = String(index + 1);
      };

      thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));
      prevBtn?.addEventListener('click', () => show(index - 1));
      nextBtn?.addEventListener('click', () => show(index + 1));

      g.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
        else if (key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      });
    });
  }

  document.addEventListener('astro:page-load', initGalleries);
</script>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 8px);
    outline: none;
  }

  .gallery:focus-visible {
    outline: 2px solid var(--jaipur-navy, #082746);
    outline-offset: 4px;
    border-radius: var(--r-md, 8px);
  }

  /* ── Stage (main image + overlaid controls) ── */
  .gallery-stage {
    position: relative;
  }

  .gallery-main {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-md, 8px);
    background: var(--haze-tint, #E4ECF5);
    display: block;
    box-shadow: var(--elev-2, 0 4px 8px rgba(8, 39, 70, 0.08));
    transition: opacity 260ms var(--ease-out, ease-out);
  }

  /* ── Nav arrows ── */
  .gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper, #fff) 82%, transparent);
    color: var(--jaipur-navy, #082746);
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(8, 39, 70, 0.18);
    transition: background var(--dur-fast, 150ms) var(--ease-out, ease-out),
                transform var(--dur-fast, 150ms) var(--ease-out, ease-out);
    outline: none;
  }

  .gallery-nav span {
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 400;
    /* nudge chevron glyphs to optical center */
    margin-top: -2px;
  }

  .gallery-nav--prev {
    left: var(--space-md, 16px);
  }

  .gallery-nav--prev span {
    margin-right: 2px;
  }

  .gallery-nav--next {
    right: var(--space-md, 16px);
  }

  .gallery-nav--next span {
    margin-left: 2px;
  }

  .gallery-nav:hover {
    background: var(--paper, #fff);
    transform: translateY(-50%) scale(1.06);
  }

  .gallery-nav:focus-visible {
    box-shadow: 0 0 0 2px var(--paper, #fff), 0 0 0 4px var(--jaipur-navy, #082746);
  }

  /* ── Position counter ── */
  .gallery-counter {
    position: absolute;
    bottom: var(--space-md, 16px);
    right: var(--space-md, 16px);
    padding: 4px 10px;
    border-radius: var(--r-sm, 4px);
    background: color-mix(in srgb, var(--jaipur-navy, #082746) 78%, transparent);
    color: var(--paper, #fff);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  /* ── Thumbnail strip ── */
  .gallery-thumbs {
    display: flex;
    flex-direction: row;
    gap: var(--space-sm, 8px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .gallery-thumbs::-webkit-scrollbar {
    display: none;
  }

  .gallery-thumb {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    border: 2px solid transparent;
    border-radius: var(--r-sm, 4px);
    background: var(--haze-tint, #E4ECF5);
    cursor: pointer;
    overflow: hidden;
    /* Inactive thumbs sit back; active/hover come forward. */
    opacity: 0.6;
    transition: border-color 150ms ease-out, opacity 200ms ease-out;
    outline: none;
  }

  .gallery-thumb:hover {
    border-color: var(--ink-soft, #94A3B8);
    opacity: 1;
  }

  .gallery-thumb:focus-visible {
    border-color: var(--jaipur-navy, #082746);
    box-shadow: 0 0 0 2px var(--jaipur-navy, #082746);
    opacity: 1;
  }

  .gallery-thumb[aria-current="true"] {
    border-color: var(--jaipur-navy, #082746);
    opacity: 1;
  }

  .gallery-thumb img {
    display: block;
    width: 120px;
    height: 80px;
    object-fit: cover;
    border-radius: 2px;
    transition: transform 300ms var(--ease-out, ease-out);
  }

  .gallery-thumb:hover img {
    transform: scale(1.06);
  }
</style>
