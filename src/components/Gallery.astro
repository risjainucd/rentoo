---
interface VideoProp { src: string; poster: string; alt: string }
interface Props {
  images: { gallery: string; full: string; alt: string }[];
  video?: VideoProp;
}
const { images, video } = Astro.props;
const hasVideo = !!video;
const slideCount = (hasVideo ? 1 : 0) + images.length;
const single = slideCount <= 1;
---
<div class="gallery" data-gallery tabindex="0" role="group" aria-roledescription="carousel" aria-label="Photo gallery">
  <div class="gallery-stage">
    <div class="gallery-track" data-gallery-track>
      {hasVideo && (
        <div class="gallery-slide" data-kind="video">
          <video
            class="gallery-video"
            data-gallery-video
            controls
            playsinline
            preload="none"
            poster={video!.poster}
            aria-label={video!.alt}
            width="1000"
            height="667"
          >
            <source src={video!.src} type="video/mp4" />
          </video>
        </div>
      )}
      {images.map((img, i) => (
        <div class="gallery-slide" data-kind="photo">
          <img
            class="gallery-main"
            src={img.gallery}
            alt={img.alt}
            width="1000"
            height="667"
            loading={i === 0 && !hasVideo ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>
    {!single && (
      <>
        <button type="button" class="gallery-nav gallery-nav--prev" data-gallery-prev aria-label="Previous slide">
          <span aria-hidden="true">&#8249;</span>
        </button>
        <button type="button" class="gallery-nav gallery-nav--next" data-gallery-next aria-label="Next slide">
          <span aria-hidden="true">&#8250;</span>
        </button>
        <div class="gallery-counter" data-gallery-counter aria-hidden="true">
          <span data-gallery-current>1</span> / {slideCount}
        </div>
        <p class="gallery-live" aria-live="polite">{`Slide 1 of ${slideCount}`}</p>
      </>
    )}
  </div>
  <div class="gallery-thumbs">
    {hasVideo && (
      <button
        class="gallery-thumb gallery-thumb--video"
        data-gallery-thumb
        data-kind="video"
        data-index="0"
        aria-label="Play video tour"
        aria-current="true"
      >
        <img src={video!.poster} alt={video!.alt} width="120" height="80" loading="lazy" />
        <span class="gallery-play-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    )}
    {images.map((img, i) => {
      const slideIndex = hasVideo ? i + 1 : i;
      return (
        <button
          class="gallery-thumb"
          data-gallery-thumb
          data-kind="photo"
          data-index={slideIndex}
          data-full={img.gallery}
          aria-label={`Photo ${i + 1}`}
          aria-current={!hasVideo && i === 0 ? 'true' : 'false'}
        >
          <img src={img.gallery} alt={img.alt} width="120" height="80" loading="lazy" />
        </button>
      );
    })}
  </div>
</div>
<script>
  import { slideIndexFromScroll } from '../lib/swipe';

  // Wired on every page load, including View Transitions navigations
  // (raw <script> tags don't re-execute on client-side nav).
  function initGalleries() {
    document.querySelectorAll('[data-gallery]').forEach((g) => {
      if ((g as HTMLElement).dataset.galleryReady) return;
      (g as HTMLElement).dataset.galleryReady = 'true';

      const track = g.querySelector('[data-gallery-track]') as HTMLElement | null;
      const slides = Array.from(g.querySelectorAll('.gallery-slide')) as HTMLElement[];
      const video = g.querySelector('[data-gallery-video]') as HTMLVideoElement | null;
      const thumbs = Array.from(g.querySelectorAll('[data-gallery-thumb]')) as HTMLButtonElement[];
      const prevBtn = g.querySelector('[data-gallery-prev]');
      const nextBtn = g.querySelector('[data-gallery-next]');
      const current = g.querySelector('[data-gallery-current]');
      const live = g.querySelector('.gallery-live');
      const total = slides.length;
      if (!track || total === 0) return;

      let index = 0;
      const slideWidth = () => slides[0].getBoundingClientRect().width;

      // The track is the source of truth: the browser moves it (finger, momentum, scrollTo) and
      // everything else follows from where it landed.
      const sync = () => {
        const next = slideIndexFromScroll(track.scrollLeft, slideWidth(), total);
        if (next === index) return;
        index = next;
        // Leaving the video slide stops it playing off-screen.
        if (video && !video.paused && slides[index].dataset.kind !== 'video') video.pause();
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
        if (current) current.textContent = String(index + 1);
        if (live) live.textContent = `Slide ${index + 1} of ${total}`;
      };

      let ticking = false;
      track.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { ticking = false; sync(); });
      }, { passive: true });

      const goTo = (n: number) => {
        const to = (n + total) % total;
        // Smooth for a step, instant for the wrap — animating back across every slide to reach
        // the first one reads as a glitch rather than as navigation.
        const wrapped = Math.abs(to - index) > 1;
        track.scrollTo({ left: to * slideWidth(), behavior: wrapped ? 'auto' : 'smooth' });
      };

      thumbs.forEach((t, i) => t.addEventListener('click', () => goTo(i)));
      prevBtn?.addEventListener('click', () => goTo(index - 1));
      nextBtn?.addEventListener('click', () => goTo(index + 1));

      g.addEventListener('keydown', (e) => {
        // Let the focused <video>'s native controls handle arrow keys (seek), don't hijack to nav.
        if ((e.target as HTMLElement)?.closest('[data-gallery-video]')) return;
        const key = (e as KeyboardEvent).key;
        if (key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1); }
        else if (key === 'ArrowRight') { e.preventDefault(); goTo(index + 1); }
      });
    });
  }

  document.addEventListener('astro:page-load', initGalleries);
</script>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 8px);
    outline: none;
  }

  .gallery:focus-visible {
    outline: 2px solid var(--jaipur-navy, #082746);
    outline-offset: 4px;
    border-radius: var(--r-md, 8px);
  }

  /* ── Stage (snap track + overlaid controls) ── */
  .gallery-stage {
    position: relative;
  }

  /* Native horizontal scrolling is the carousel: the finger drags the photo, momentum and
     snapping come from the browser, and the arrows just scrollTo. */
  .gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--r-md, 8px);
    box-shadow: var(--elev-2, 0 4px 8px rgba(8, 39, 70, 0.08));
    /* Keep a swipe inside the gallery from triggering the browser's back gesture. */
    overscroll-behavior-x: contain;
  }

  .gallery-track::-webkit-scrollbar { display: none; }

  .gallery-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: center;
  }

  .gallery-main {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--haze-tint, #E4ECF5);
    display: block;
  }

  /* ── Nav arrows ── */
  .gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper, #fff) 82%, transparent);
    color: var(--jaipur-navy, #082746);
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(8, 39, 70, 0.18);
    transition: background var(--dur-fast, 150ms) var(--ease-out, ease-out),
                transform var(--dur-fast, 150ms) var(--ease-out, ease-out);
    outline: none;
  }

  .gallery-nav span {
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 400;
    /* nudge chevron glyphs to optical center */
    margin-top: -2px;
  }

  .gallery-nav--prev {
    left: var(--space-md, 12px);
  }

  .gallery-nav--prev span {
    margin-right: 2px;
  }

  .gallery-nav--next {
    right: var(--space-md, 12px);
  }

  .gallery-nav--next span {
    margin-left: 2px;
  }

  .gallery-nav:hover {
    background: var(--paper, #fff);
    transform: translateY(-50%) scale(1.06);
  }

  .gallery-nav:focus-visible {
    box-shadow: 0 0 0 2px var(--paper, #fff), 0 0 0 4px var(--jaipur-navy, #082746);
  }

  /* ── Position counter ── */
  .gallery-counter {
    position: absolute;
    bottom: var(--space-md, 12px);
    right: var(--space-md, 12px);
    padding: 4px 10px;
    border-radius: var(--r-sm, 4px);
    background: color-mix(in srgb, var(--jaipur-navy, #082746) 78%, transparent);
    color: var(--paper, #fff);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  /* ── Thumbnail strip ── */
  .gallery-thumbs {
    display: flex;
    flex-direction: row;
    gap: var(--space-sm, 8px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .gallery-thumbs::-webkit-scrollbar {
    display: none;
  }

  .gallery-thumb {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    border: 1px solid var(--line, #E5E0D5);
    border-radius: var(--r-sm, 4px);
    background: var(--haze-tint, #E4ECF5);
    cursor: pointer;
    overflow: hidden;
    /* Inactive thumbs sit back; active/hover come forward. */
    opacity: 0.6;
    transition: border-color var(--dur-fast, 150ms) var(--ease-out, ease-out),
                box-shadow var(--dur-base, 200ms) var(--ease-out, ease-out),
                opacity var(--dur-base, 200ms) var(--ease-out, ease-out);
    outline: none;
  }

  .gallery-thumb:hover {
    border-color: var(--ink-soft, #94A3B8);
    opacity: 1;
  }

  .gallery-thumb:focus-visible {
    border-color: var(--jaipur-navy, #082746);
    box-shadow: 0 0 0 2px var(--paper, #FAF7EE), 0 0 0 4px var(--focus-clay, #EA580C);
    opacity: 1;
  }

  .gallery-thumb[aria-current="true"] {
    border-color: var(--jaipur-navy, #082746);
    box-shadow: var(--elev-2, 0 4px 8px rgba(8, 39, 70, 0.06));
    opacity: 1;
  }

  .gallery-thumb img {
    display: block;
    width: 120px;
    height: 80px;
    object-fit: cover;
    transition: transform var(--dur-slow, 300ms) var(--ease-out, ease-out);
  }

  .gallery-thumb:hover img {
    transform: scale(1.06);
  }

  /* Position announcements for assistive tech only — the visible counter is
     aria-hidden because it duplicates this. */
  .gallery-live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── Video slide ── */
  .gallery-video {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;            /* vertical WhatsApp clip letterboxed, not cropped */
    background: var(--jaipur-navy, #082746);
    display: block;
  }

  /* At the full 1216px column a 3:2 stage is 810px tall, so on a laptop the first
     screen is nothing but photo — the price, the status and the contact card all
     start below the fold. Cap the stage once there is room for the sidebar. */
  @media (min-width: 1024px) {
    .gallery-main,
    .gallery-video {
      max-height: 60vh;
    }
  }

  .gallery-thumb--video { position: relative; }

  .gallery-play-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper, #fff);
    background: color-mix(in srgb, var(--jaipur-navy, #082746) 28%, transparent);
    pointer-events: none;           /* clicks fall through to the button */
  }
  .gallery-play-badge svg { filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5)); }
</style>
